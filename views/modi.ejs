
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Modi Product</title>
<link rel="stylesheet" href="/css/style.css">
<style>
  * {
    box-sizing: border-box;
  }

  .container {
    width: min(92%, 760px);
    margin: 0 auto;
    padding: 28px 0 50px;
    text-align: center;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 16px;
    color: #00ff90;
    text-decoration: none;
    font-size: 14px;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  h1 {
    margin: 6px 0 20px;
    font-size: clamp(28px, 5vw, 42px);
    text-shadow: 0 0 18px rgba(0, 255, 144, 0.3);
  }

  .modi-photo {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
    max-height: 420px;
    object-fit: cover;
    object-position: center top;
    margin: 0 auto 24px;
    border-radius: 16px;
    border: 2px solid #00ff90;
    box-shadow: 0 12px 35px rgba(0, 255, 144, 0.25);
  }

  .card {
    text-align: center;
    padding: 24px;
  }

  .card button {
    width: 100%;
    max-width: 280px;
    font-size: 16px;
  }

  .result:empty {
    display: none;
  }

  @media (max-width: 520px) {
    .modi-photo {
      max-width: 280px;
    }
  }
</style>
</head>
<body>

<div class="container">

<a class="back-link" href="/">← Back to Mitron Market</a>

<h1>Modi Ka Dimag</h1>

<img
  class="modi-photo"
  src="https://preview.redd.it/einstein-damodar-das-modi-v0-mq86ip3vqltg1.jpeg?width=640&crop=smart&auto=webp&s=d71e6fd3d34e1b3bb88aed97fa8d22042479f136"
  alt="Modi Ka Dimag"
  referrerpolicy="no-referrer"
>

<div class="card">

<h2>Price: ₹7 Crore</h2>

<p>Mitron... price thoda zyada nahi ho gaya? 👀</p>

<button onclick="buy()">Buy Now</button>

<div class="result" id="buyResult"></div>

<!-- Hidden meme audio: replay every time Buy Now is pressed. -->
<audio id="buyNowAudio" preload="auto" playsinline
  src="https://www.myinstants.com/media/sounds/is-sajjan-ko-kya-takleef-hai-bhai.mp3"></audio>

</div>

</div>

<script>

async function buy(){

    // Play the existing page audio on every Buy Now click (no visible player).
    const audio = document.getElementById('buyNowAudio');
    if (audio) {
        try {
            audio.currentTime = 0;
            await audio.play();
        } catch (e) {
            // The click itself is a user gesture; retry without blocking the buy request.
            audio.play().catch(() => {});
        }
    }

    const res = await fetch('/buy',{
        method:'POST',
        headers:{
            'Content-Type':'application/json'
        },
        body:JSON.stringify({
            product:'Modi Ka Dimag',
            price:70000000
        })
    });

    const data = await res.json();

    if(data.success){
        document.getElementById('buyResult').innerText = data.flag;
    }else{
        document.getElementById('buyResult').innerText = data.message;
    }
}

</script>

</body>
</html>
